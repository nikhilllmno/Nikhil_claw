{
  "manifest_version": 3,
  "name": "sama",
  "short_name": "sama",
  "version": "0.2.0",
  "description": "Chat with your sama agent next to any tab, ask about the page, and let sama act in your browser.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open sama", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab", "debugger"],
  "host_permissions": ["https://sama-staging.fly.dev/*", "https://sama-production.fly.dev/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*", "<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
